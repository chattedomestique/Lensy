<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sunhouse.lensy-watchdog</string>

    <!-- The installed copy, like lensyd.sh — see com.sunhouse.lensy.plist.template. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__BIN__/lensy-watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <!-- Periodic probe, not a resident process: launchd runs it, it exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/lensy/watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/lensy/watchdog.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LENSY_PORT</key>
        <string>__PORT__</string>
    </dict>

    <key>Nice</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
